{
  "manifest_version": 2,
  "id": "maibot-team.matrix-adapter",
  "version": "0.1.0",
  "name": "Matrix 适配器",
  "description": "基于 matrix-nio 与 vodozemac 的 Matrix 双向消息网关，支持加密房间、图片、表情、语音、@、回复引用与表态通知。",
  "author": {"name": "MaiBot Team", "url": "https://github.com/Mai-with-u"},
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot-Matrix-Adapter",
    "homepage": "https://github.com/Mai-with-u/MaiBot-Matrix-Adapter",
    "documentation": "https://github.com/Mai-with-u/MaiBot-Matrix-Adapter/blob/main/README.md",
    "issues": "https://github.com/Mai-with-u/MaiBot-Matrix-Adapter/issues"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "adapter",
  "host_application": {"min_version": "1.3.18", "max_version": "1.99.99"},
  "sdk": {"min_version": "2.19.0", "max_version": "2.98.99"},
  "dependencies": [
    {"type": "python_package", "name": "matrix-nio", "version_spec": ">=0.26.0,<0.27"},
    {"type": "python_package", "name": "vodozemac", "version_spec": ">=0.9.0.post2,<0.11"},
    {"type": "python_package", "name": "peewee", "version_spec": "~=3.14"},
    {"type": "python_package", "name": "cachetools", "version_spec": ">=5.3"},
    {"type": "python_package", "name": "atomicwrites", "version_spec": "~=1.4"},
    {"type": "python_package", "name": "msgpack", "version_spec": ">=1.0"}
  ],
  "capabilities": ["chat.get_all_streams"],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
